# Gemini API key (Google AI Studio, free tier) used to generate the
# personalized narrative summary. Checked first; DeepSeek is used as a
# fallback if this is not set or the call fails. The app is fully functional
# without either: a complete, rule-based action plan is always generated;
# only the AI-written narrative section is skipped.
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to "gemini-3.8-flash").
GEMINI_MODEL=

# DeepSeek API key, used as a fallback if Gemini is not configured.
DEEPSEEK_API_KEY=

# Optional: override the DeepSeek chat model (defaults to "deepseek-chat").
DEEPSEEK_MODEL=
